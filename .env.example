# Copy this file to .env and fill in the values. Never commit .env.

# Option A - your Neon database (Neon dashboard > Connect > copy the connection string):
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_SSL=true
#
# Option B - local Postgres on your computer:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gymlog
DATABASE_SSL=false

# Long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Set to false after you've made your account, so nobody else can sign up.
ALLOW_SIGNUPS=true

PORT=3000
NODE_ENV=development
